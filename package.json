{
  "name": "conversational-banking-data-analyst",
  "version": "1.0.0",
  "description": "Conversational Banking Data Analyst - Monorepo root orchestrating independent frontend and backend packages",
  "scripts": {
    "db:seed": "npm --prefix backend run db:seed",
    "db:verify": "npm --prefix backend run db:verify",
    "backend:dev": "npm --prefix backend run dev",
    "backend:build": "npm --prefix backend run build",
    "backend:test": "npm --prefix backend run test",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:test": "npm --prefix frontend run test",
    "test": "npm run backend:test && npm run frontend:test"
  },
  "keywords": [
    "banking",
    "analytics",
    "react",
    "vite",
    "express",
    "sqlite",
    "typescript"
  ],
  "author": "",
  "license": "ISC"
}
