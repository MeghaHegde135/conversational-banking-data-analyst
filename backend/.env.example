# ====================================================================
# Conversational Banking Data Analyst - Environment Variables Example
# NOTE: Never commit production credentials, passwords, or keys to Git
# ====================================================================

# Backend Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api
CORS_ORIGIN=http://localhost:5173

# Database Configuration (SQLite)
DB_FILE=./src/database/banking.db
DB_PASSWORD=mock_secure_db_password_example
DB_ENCRYPTION_KEY=mock_32_char_db_encryption_key!

# Authentication & Security Secrets
JWT_SECRET=mock_jwt_secret_token_change_in_production_2026
SESSION_SECRET=mock_session_secret_change_in_production_2026

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:5000/api
