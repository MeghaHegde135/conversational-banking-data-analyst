{
  "name": "conversational-banking-backend",
  "version": "1.0.0",
  "description": "Backend API for Conversational Banking Data Analyst with SQLite and strict TypeScript",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"require('node:fs').copyFileSync('src/database/scheme.sql', 'dist/database/scheme.sql')\"",
    "start": "node dist/index.js",
    "db:seed": "node src/database/seed.cjs",
    "db:verify": "node src/database/verify.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "banking",
    "data-analyst",
    "express",
    "typescript",
    "sqlite",
    "zod"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
